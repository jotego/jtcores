#
# APF constraints
# Do not edit this file.
#
# Add your own constraints in the \core_constraints.sdc in the core directory, which will also be loaded.

create_clock -name clk_74a -period 13.468 [get_ports clk_74a]
create_clock -name clk_74b -period 13.468 [get_ports clk_74b]
create_clock -name spi_clk -period 13.468 [get_ports spi_clk]

# This is tDS in the data sheet, setup time, spec is 1.5ns
set_output_delay -clock dram_clk -max 1.5 \
    [get_ports {dram_a[*] dram_ba[*] dram_cke dram_dqm[*] \
                dram_dq[*] dram_ras_n dram_cas_n dram_we_n}]

# this is tdh in the data sheet, hold time, spec is 1.0ns
set_output_delay -add_delay -clock  dram_clk -min -1.0 \
    [get_ports {dram_a[*] dram_ba[*] dram_cke dram_dqm[*] \
                dram_dq[*] dram_ras_n dram_cas_n dram_we_n}]

set_input_delay -clock dram_clk -min 2.5 [get_ports {dram_dq[*]}]
set_input_delay -clock dram_clk -max 5.3 [get_ports {dram_dq[*]}] -add_delay

set_multicycle_path -hold \
    -to [get_ports {dram_a[*] dram_ba[*] dram_cke dram_dqm[*] \
                    dram_dq[*] dram_ras_n dram_cas_n dram_we_n}] 2

# setup/hold time requirements for CRAM 0. The Cell RAM is used only by the
# line-frame buffer, whose controller always runs on clk48. The controller
# register also provides a synthesized-object guard for cores without it.
set jtframe_lfbuf_ctrl [get_keepers -nowarn {*|u_lfbuf|u_ctrl|st[0]}]
if { [get_collection_size $jtframe_lfbuf_ctrl] > 0 } {
    set jtframe_cram0_source \
        {u_clocks|u_pll_game|altpll_component|auto_generated|generic_pll1~PLL_OUTPUT_COUNTER|divclk}
    if { [get_collection_size [get_clocks -nowarn \
        {u_clocks|u_pll_game|altpll_component|auto_generated|generic_pll2~PLL_OUTPUT_COUNTER|divclk}]] > 0 } {
        set jtframe_cram0_source \
            {u_clocks|u_pll_game|altpll_component|auto_generated|generic_pll2~PLL_OUTPUT_COUNTER|divclk}
    }
    create_generated_clock -name cram0_clk -source \
        $jtframe_cram0_source \
        -divide_by 1 [get_ports cram0_clk]

    # tSP
    set_output_delay -clock cram0_clk -max 3 \
        [get_ports {cram0_a[*] cram0_dq[*] cram0_adv_n cram0_cre \
                    cram0_oe_n cram0_we_n \
                    cram0_ub_n cram0_lb_n }]

    # tCSP
    set_output_delay -clock cram0_clk -max 4 \
        [get_ports {cram0_ce0_n cram0_ce1_n }]

    # tHD, hold time
    set_output_delay -add_delay -clock cram0_clk -min -2 \
        [get_ports {cram0_a[*] cram0_dq[*] cram0_adv_n cram0_cre \
                    cram0_ce0_n cram0_ce1_n cram0_oe_n cram0_we_n \
                    cram0_ub_n cram0_lb_n }]

    set_input_delay -clock cram0_clk -min 2 [get_ports {cram0_dq[*]}]
    set_input_delay -clock cram0_clk -max 9 [get_ports {cram0_dq[*]}] -add_delay

    set_input_delay -clock [get_clocks {cram0_clk}] -min 9 [get_ports {cram0_wait}]
    # max spec for cram0_wait does not appear on the data sheet. Setting a value
    # to prevent warnings
    set_input_delay -clock [get_clocks {cram0_clk}] -max 10 [get_ports {cram0_wait}] -add_delay
    set_false_path -from [get_ports {cram0_wait}]

    # ignore clock falling edge
    set_false_path -fall_from [get_clocks {cram0_clk}] \
        -to [get_ports {cram0_a[*] cram0_dq[*] cram0_adv_n cram0_cre \
                cram0_ce0_n cram0_ce1_n cram0_oe_n cram0_we_n \
                cram0_ub_n cram0_lb_n }]
}

# CRAM1 not supported in JTFRAME yet

# JTFRAME specific:

# The VU meter is a debug-only display. Audio-rate mixer data may cross into
# its system-clock accumulators without affecting game audio or video.
set jtframe_vumeter_mixed [get_keepers -nowarn {*|jtframe_rcmix:u_rcmix|mixed[*]}]
set jtframe_vumeter_ml    [get_keepers -nowarn {*|jtframe_vumeter:vumeter|ml[*]}]
set jtframe_vumeter_mr    [get_keepers -nowarn {*|jtframe_vumeter:vumeter|mr[*]}]
set jtframe_vumeter_l2r2  [get_keepers -nowarn {*|jtframe_vumeter:vumeter|l2r2[*]}]
if { [get_collection_size $jtframe_vumeter_mixed] > 0 } {
    if { [get_collection_size $jtframe_vumeter_ml] > 0 } {
        set_false_path -from $jtframe_vumeter_mixed -to $jtframe_vumeter_ml
    }
    if { [get_collection_size $jtframe_vumeter_mr] > 0 } {
        set_false_path -from $jtframe_vumeter_mixed -to $jtframe_vumeter_mr
    }
    if { [get_collection_size $jtframe_vumeter_l2r2] > 0 } {
        set_false_path -from $jtframe_vumeter_mixed -to $jtframe_vumeter_l2r2
    }
}

# Data will be settled by the time it is read by tx_buf
set jtframe_bridge_rd [get_keepers -nowarn {jtframe_pocket:u_frame|jtframe_pocket_base:u_base|core_bridge_cmd:u_cmd|bridge_rd_data_out[*]}]
set jtframe_spi_tx [get_keepers -nowarn {jtframe_pocket:u_frame|jtframe_pocket_base:u_base|jtframe_pocket_spi:u_spi|tx_buf[*]}]
if { [get_collection_size $jtframe_bridge_rd] > 0 && [get_collection_size $jtframe_spi_tx] > 0 } {
    set_false_path -from $jtframe_bridge_rd -to $jtframe_spi_tx
}

# if the reset isn't stable, we should reset anyway, so ignore it.
set_false_path -from [get_keepers {jtframe_pocket:u_frame|jtframe_board:u_board|jtframe_reset:u_reset|rst}] -to [get_keepers {jtframe_pocket:u_frame|jtframe_pocket_base:u_base|rstn_74a}]

# Synchronizers
# If the sychronizer gets synthesized as logic:
set_false_path -to [get_keepers {*|jtframe_sync:*|synchronizer[*].s[0]}]
# If the sychronizer gets synthesized as RAM (this actually covers the other case too)
set_false_path -to [get_keepers {*|jtframe_sync:*}]
set_false_path -to [get_keepers {*|jtframe_crossclk_strobe:*|sclr[*]}]
set_false_path -to [get_keepers {*|jtframe_crossclk_strobe:*|sset[*]}]

######################################################################
# False paths because of many cycles between the set and get clocks

set_false_path -from [get_keepers {jtframe_pocket:u_frame|jtframe_pocket_base:u_base|jtframe_pocket_cmd:u_cmd|sys_din[*]}] -to [get_keepers {jtframe_pocket:u_frame|jtframe_pocket_base:u_base|jtframe_pocket_spi:u_spi|tx_buf[*]}]

set_false_path -from [get_keepers {jtframe_pocket:u_frame|jtframe_pocket_base:u_base|jtframe_pocket_spi:u_spi|addr[*]}] -to [get_keepers {jtframe_pocket:u_frame|jtframe_pocket_base:u_base|jtframe_pocket_cmd:u_cmd|sys_din[*]}]
set_false_path -from [get_keepers {jtframe_pocket:u_frame|jtframe_pocket_base:u_base|jtframe_pocket_spi:u_spi|addr[*]}] -to [get_keepers {jtframe_pocket:u_frame|jtframe_pocket_base:u_base|jtframe_pocket_cmd:u_cmd|*}]

# The u_spi.addr is always stable by the time u_base can read it. So these can all be set as false paths
set_false_path -from [get_keepers {jtframe_pocket:u_frame|jtframe_pocket_base:u_base|jtframe_pocket_spi:u_spi|addr[*]}] -to [get_keepers {jtframe_pocket:u_frame|jtframe_pocket_base:u_base*}]
# The u_spi.dout is always stable by the time u_base can read it. So these can all be set as false paths
set_false_path -from [get_keepers {jtframe_pocket:u_frame|jtframe_pocket_base:u_base|jtframe_pocket_spi:u_spi|dout[*]}] -to [get_keepers {jtframe_pocket:u_frame|jtframe_pocket_base:u_base*}]

set_false_path -from [get_keepers {jtframe_pocket:u_frame|jtframe_pocket_base:u_base|jtframe_pocket_input:u_input|*}] -to [get_keepers {jtframe_pocket:u_frame|jtframe_board:u_board|jtframe_inputs:u_inputs|*}]

# set_multicycle_path -setup -end -from [get_keepers {jtframe_pocket:u_frame|jtframe_pocket_base:u_base|jtframe_lfbuf_cram:u_lfbuf|jtframe_lfbuf_ctrl:u_ctrl|cr_oen}] -to [get_keepers {cram0_dq[*]}] 1.5
