#!/usr/bin/env bash
# Build the native exporter that shares CabinetScript with jtsim.

main() {
    if [[ -z ${JTFRAME:-} || ! -f $JTFRAME/verilator/cabinet_export.cpp ]]; then
        echo 'JTFRAME is not set; source setprj.sh first.' >&2
        return 2
    fi
    local executable=$JTFRAME/bin/cabinet_pack
    local source file rebuild=0 build_only=0
    if [[ ${1:-} == --build ]]; then
        rebuild=1
        build_only=1
        shift
        if (($#)); then echo 'usage: jtframe-cab-pack --build' >&2; return 2; fi
    fi
    source=$JTFRAME/verilator
    if [[ ! -x $executable ]]; then rebuild=1; fi
    for file in cabinet_export.cpp cabinet.cpp cabinet.h sim_utils.cpp sim_utils.h; do
        if [[ $source/$file -nt $executable ]]; then rebuild=1; fi
    done
    if ((rebuild)); then
        build_exporter "$source" "$executable" || return
    fi
    if ((build_only)); then return 0; fi
    "$executable" "$@"
}

build_exporter() (
    local source=$1 executable=$2 temporary
    temporary=$(mktemp /tmp/jtframe-cab-pack-XXXXXX) || return
    trap 'rm -f "$temporary"' EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    "${CXX:-c++}" -O2 -std=c++17 -Wall -Wextra -pedantic -I"$source" \
        "$source/cabinet_export.cpp" "$source/cabinet.cpp" "$source/sim_utils.cpp" \
        -o "$temporary" || return
    chmod +x "$temporary" && mv -f "$temporary" "$executable"
)

main "$@"
