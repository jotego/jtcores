#!/bin/bash -e
# Copies the contents of JTBIN to a test folder
# in MiSTer

function main {
    LOCAL=1
    V=
    BUILD=
    SKIP_SD=0
    FOLDER=_JTBIN
    DELETE_HASH_FOLDERS=0
    SDCARD=${JTBIN2MR_SD:-/media/$USER/MiSTer_Data}

    check_jtroot
    parse_args "$@"
    check_folder
    extract_build
    select_source
    check_mister_password
    set_mister_defaults
    gather_files
    copy_to_mister
    rm -rf "$TEMP"
}

function show_help {
cat<<HELP
    JTFRAME (c) Jose Tejada 2023

Copies the contents of JTBIN or the release folder to
a MiSTer device in the network.

If called with a git hash, extracts the contents of
\$JTBUILDS/hash.zip to \$JTROOT/release first and then
copies it to MiSTer.

Usage:

jtbin2mr [build hash]

-m, --mr        MiSTer host name or IP address
-g, --git       Uses JTBIN as the source folder, rather than \$JTROOT/release
-h, --help      Help
-v, --verbose
--skip-sd       Never copy to a MiSTer SD card mounted locally, always use the network
--folder name   Destination folder in /media/fat (default _JTBIN). It must be _ followed
                by letters, digits, '.', '_' or '-'. _Arcade, _Console, _Computer,
                _Other and _Utility are refused
--delete-hash-folders
                Before the network copy, remove every /media/fat/_<7 hex digits> and
                /media/fat/_<7 hex digits>-dirty folder in MiSTer

The cab folder of the source, when present, is copied as <folder>/cab.
JTBIN2MR_SD overrides the SD card path (default /media/\$USER/MiSTer_Data).
Several copies may run at once with -g and different -m hosts. Do not pass a
build hash to parallel copies, as each one extracts it to \$JTROOT/release.
HELP
}

function check_jtroot {
    if [ -z "$JTROOT" ]; then
        echo "JTROOT is undefined"
        exit 1
    fi
}

function check_mister_password {
    if [ -z "$MISTERPASSWD" ]; then
        echo "Define the MiSTer password in the environment variable MISTERPASSWD"
        exit 1
    fi
}

function parse_args {
    while [ $# -gt 0 ]; do
        case "$1" in
            -g|--git)
                LOCAL=0;; # JTBIN will not be modified
            -m|--mr)
                shift
                export MRHOST=$1;;
            -v|--verbose)
                V=-v;;
            --skip-sd)
                SKIP_SD=1;;
            --folder)
                if [ $# -lt 2 ]; then
                    echo "--folder needs a folder name"
                    exit 1
                fi
                shift
                FOLDER=$1;;
            --delete-hash-folders)
                DELETE_HASH_FOLDERS=1;;
            -h|--help)
                show_help
                exit 1;;
            *)
                HASH=$(git rev-parse --short "$1")
                HASH=${HASH:0:7}
                BUILD="$JTBUILDS/${HASH}.zip"
                if [ ! -e "$BUILD" ]; then
                    echo "Cannot find $BUILD"
                    echo "Unknown argument $1"
                    exit 1
                fi;;
        esac
        shift
    done
}

# The folder name goes into rm -rf commands, so only plain names are accepted
function check_folder {
    if [[ ! "$FOLDER" =~ ^_[A-Za-z0-9._-]+$ ]]; then
        echo "Invalid folder name '$FOLDER': use _ followed by letters, digits, '.', '_' or '-'"
        exit 1
    fi
    case "${FOLDER,,}" in
        _arcade|_console|_computer|_other|_utility)
            echo "Refusing to use the MiSTer system folder $FOLDER"
            exit 1;;
    esac
}

function extract_build {
    if [ -z "$BUILD" ]; then
        return
    fi

    rm -rf "$JTROOT/release"
    if unzip -l "$BUILD" | grep '\brelease/' > /dev/null; then
        unzip -q "$BUILD" -d "$JTROOT"
    else
        mkdir "$JTROOT/release"
        unzip -q "$BUILD" -d "$JTROOT/release"
    fi
}

function select_source {
    if pwd | grep "$JTBIN"; then
        echo "Copying from JTBIN as the current working dir is JTBIN"
    elif [ "$LOCAL" = 1 ]; then
        export JTBIN=$JTROOT/release
    fi
}

function set_mister_defaults {
    if [ -z "$MRHOST" ]; then
        MRHOST=mister.home
    fi

    if [ -z "$MRUSER" ]; then
        MRUSER=root
    fi
}

function gather_files {
    if [ "$V" = -v ]; then echo "Gathering the files from $JTBIN"; fi
    TEMP=$(mktemp --directory)
    ROOT=$TEMP/$FOLDER
    CORES=$ROOT/cores

    mkdir -p "$CORES"

    if [ -d "$JTBIN/mister" ]; then
        cp "$JTBIN"/mister/*.rbf "$CORES"
    fi

    local mra_dir="$JTBIN/mister/mra"
    [ -d "$mra_dir" ] || mra_dir="$JTBIN/mra"
    cp -r "$mra_dir"/* "$ROOT"
    if [ -d "$JTBIN/games" ]; then cp -r "$JTBIN/games" "$ROOT"; fi
    if [ -d "$JTBIN/cab" ]; then cp -r "$JTBIN/cab" "$ROOT"; fi
}

function copy_to_mister {
    if [ -n "$V" ]; then echo -e "\nCopying the files to MiSTer"; fi
    if [ "$SKIP_SD" = 0 ] && [ -d "$SDCARD" ]; then
        copy_to_sd_card
    elif ping -c 1 -q "$MRHOST" > /dev/null; then
        copy_over_network
    else
        echo "$MRHOST is not online"
        rm -rf "$TEMP"
        exit 1
    fi
}

function copy_to_sd_card {
    echo "MiSTer SD card detected"
    rm -rf "${SDCARD:?}/$FOLDER"
    cp -r "$TEMP/$FOLDER" "$SDCARD" || echo "Copy to MiSTer SD card failed"
    copy_console_core_to_sd_card neogeopocket.rbf NeoGeoPocket.rbf
    copy_console_core_to_sd_card neogeopocket-color.rbf NeoGeoPocket-Color.rbf
    if [ -e "$JTUTIL/jtbeta.zip" ]; then
        cp "$JTUTIL/jtbeta.zip" "$SDCARD/games/mame"
    fi
}

function copy_console_core_to_sd_card {
    local source_name=$1
    local console_name=$2

    if [ -e "$JTBIN/mister/$source_name" ]; then
        mkdir -p "$SDCARD/_Console"
        cp "$TEMP/$FOLDER/cores/$source_name" "$SDCARD/_Console/$console_name"
    fi
}

function copy_over_network {
    MRCMD="sshpass -p $MISTERPASSWD ssh -l $MRUSER $MRHOST"
    if [ "$DELETE_HASH_FOLDERS" = 1 ]; then delete_hash_folders; fi
    $MRCMD "rm -rf /media/fat/$FOLDER"
    $MRCMD "rm -rf /media/fat/config/*.{cfg,CFG}"
    $MRCMD "rm -rf /media/fat/config/nvram/*.nvm"
    $MRCMD "rm -rf /media/fat/config/dips/*"
    if sshpass -p "$MISTERPASSWD" scp -r "$TEMP"/* "$MRUSER@${MRHOST}:/media/fat"; then
        copy_console_core neogeopocket.rbf NeoGeoPocket.rbf
        copy_console_core neogeopocket-color.rbf NeoGeoPocket-Color.rbf
        rm -rf "$TEMP"
    else
        echo "Copy to MiSTer failed. Temporary files in $TEMP"
        exit 1
    fi
    copy_beta_zip
}

function copy_console_core {
    local source_name=$1
    local console_name=$2

    if [ -e "$JTBIN/mister/$source_name" ]; then
        $MRCMD "cp /media/fat/$FOLDER/cores/$source_name /media/fat/_Console/$console_name"
    fi
}

# Folders named after a build hash, as _1234abc or _1234abc-dirty. Plain sh for busybox
function delete_hash_folders {
    local h='[0-9a-f]'
    local pattern="_$h$h$h$h$h$h$h"
    # shellcheck disable=SC2016 # expanded by the remote shell
    $MRCMD 'for d in /media/fat/_*; do case "${d#/media/fat/}" in '"$pattern|$pattern-dirty"') if [ -d "$d" ]; then rm -rf "$d"; fi;; esac; done'
}

function copy_beta_zip {
    if [ -e "$JTUTIL/jtbeta.zip" ]; then
        sshpass -p "$MISTERPASSWD" scp -r "$JTUTIL/jtbeta.zip" "$MRUSER@${MRHOST}:/media/fat/games/mame"
    else
        echo "Skipping jtbeta.zip copy"
    fi
}

main "$@"
