// GENERATED by sw/gen_ucore_tables.py from docs/V20BITS.TXT and
// docs/pla3_outputs.txt.  DO NOT HAND-EDIT.  Gate G0
// (`python3 sw/check_ucore_tables.py`) proves this file byte-matches
// the C++ reference model's own tables.
//
// The group-decode PLA: a 2-bit decode-mode prefix + the 8 opcode
// bits -> a 14-bit vector.  Three separate 256-entry tables
// (sim/pla3_table.h):
//     prefix 01 -> native   (native V20/V30 first-byte opcode)
//     prefix 00 -> mode8080 (8080 emulation mode, entered by BRKEM)
//     prefix 11 -> ext      (second byte of the 0F extension page)
//
// Bit numbering matches the model: the dumps print the vector
// MSB-first as b0..b13 and b0 is stored in bit 13, so XOP[3:0]
// (b10..b13) lands in the low nibble.
//
// `include this inside a module body.  Pure combinational case ROMs;
// no state, no clock.

  // --- decode-mode prefixes ---
  localparam logic [1:0] PLA3_MODE_8080 = 2'b00;
  localparam logic [1:0] PLA3_MODE_NATIVE = 2'b01;
  localparam logic [1:0] PLA3_MODE_EXT    = 2'b11;

  // --- named columns (sim/pla3_table.h::Col) ---
  localparam logic [13:0] PLA3_BYTE_ONLY       = 14'h2000; // b0  byte-width-only data op, no W bit
  localparam logic [13:0] PLA3_W_FROM_BIT0     = 14'h1000; // b1  operand width = opcode bit 0
  localparam logic [13:0] PLA3_ONE_BYTE_LOGIC  = 14'h0800; // b2  1BL: executed by logic, no microcode
  localparam logic [13:0] PLA3_ACC_W_OPERAND   = 14'h0400; // b3  implicit AL/AW operand, width from W
  localparam logic [13:0] PLA3_SREG_MOV        = 14'h0200; // b4  MOV to/from a segment register (8C/8E)
  localparam logic [13:0] PLA3_HAS_MODRM       = 14'h0100; // b5  a ModR/M byte follows
  localparam logic [13:0] PLA3_MODRM_STORE     = 14'h0080; // b6  r/m operand written without being read
  localparam logic [13:0] PLA3_DIR_FROM_BIT1   = 14'h0040; // b7  source/destination direction = opcode bit 1
  localparam logic [13:0] PLA3_NATIVE_HI       = 14'h0020; // b8  native opcode >= 0x80 (map-half select)
  localparam logic [13:0] PLA3_INCDEC_NO_CY    = 14'h0010; // b9  INC/DEC class: CY must not be updated
  // b10..b13 = XOP[3:0], a 4-bit auxiliary op-select field.
  localparam logic [13:0] PLA3_XOP_MASK      = 14'h000F;

  // --- XOP[3:0] when ONE_BYTE_LOGIC is set (sim/pla3_table.h::Bl1Op) ---
  localparam logic [3:0] PLA3_BL1_SEG_PREFIX = 4'h0; // 26/2E/36/3E
  localparam logic [3:0] PLA3_BL1_EXT_PREFIX = 4'h1; // native 0F, 8080 ED
