# [*]
CORENAME=JTNEMSIS

JTFRAME_BUTTONS=3
JTFRAME_COLORW=8
JTFRAME_RATE=60.61
JTFRAME_HSIZE_DIV=8
JTFRAME_WIDTH=256
JTFRAME_HEIGHT=224
debug JTFRAME_IOCTL_RD=86032

# accurate pixel clock
# 18.432MHz/3 -> 6.144MHz pixel clock, 384x264 total, 60.606Hz
# (nemesis.cpp gx400_base_state::set_screen_raw_params)
JTFRAME_PLL=jtframe_pll6144

JTFRAME_BA1_START=0x40000
JTFRAME_PROM_START=0x44000

# GX400 custom-chip build options
# wide address busses in K5295 instead of RAS/CAS
GX400_UNFOLD_DRAM_ADDR

SDRAM_FIX

[mister]
JTFRAME_ARX=5
JTFRAME_ARY=4

[mist|sidi|neptuno]
JTFRAME_SKIP
