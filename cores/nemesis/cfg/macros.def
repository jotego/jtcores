[*]
CORENAME=JTNEMESIS
JTFRAME_BUTTONS=3
JTFRAME_COLORW=8
JTFRAME_WIDTH=256
JTFRAME_HEIGHT=224

# Run make in the core firmware folder to generate hex files
JTFRAME_BUILD_FIRMWARE

JTFRAME_OSD_NOLOAD
JTFRAME_OSD_NOLOGO
JTFRAME_CREDITS
JTFRAME_CREDITS_PAGES=2

# accurate pixel clock
JTFRAME_PLL=jtframe_pll6144

# unsigned sound
# TODO: does it still exist?
JTFRAME_SIGNED_SND=0

JTFRAME_SDRAM_BANKS

JTFRAME_BA1_START=0x40000
# Determines from which ioctl_addr offset (in bytes) data stops
# being sent to SDRAM and starts being sent to PROMs (BRAM),
# using the prog_addr, prog_data, and prom_we signals.
JTFRAME_PROM_START=0x44000

JT49_EXP=nemesis_jt49_exp
VOLUME_PROMS=8'd104
VOLUME_AY1=8'd138
VOLUME_AY2=8'd102

#ROM_DEBUG_Z80
#ROM_DEBUG_MAIN

# wide address busses in K5295 instead of RAS/CAS
GX400_UNFOLD_DRAM_ADDR

SDRAM_FIX
K5291_NO_MUX

#NOMAIN
#NOSOUND
#NOVIDEO
#TEST68K
#SOUND_TEST

[mister]
JTFRAME_ARX=5
JTFRAME_ARY=4

# include debug.def
