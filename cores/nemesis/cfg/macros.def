CORENAME=JTNEMESIS

JTFRAME_BUTTONS=3
JTFRAME_COLORW=8
JTFRAME_WIDTH=256
JTFRAME_HEIGHT=224

# 18.432MHz/3 -> 6.144MHz pixel clock, 384x264 total, 60.606Hz
# (nemesis.cpp gx400_base_state::set_screen_raw_params)
JTFRAME_PLL=jtframe_pll6144

JTFRAME_DIPBASE=16

# ---- ROM map, byte offsets ----
SND_START          =0x040000
JTFRAME_PROM_START =0x044000

# GX400 custom-chip build options
# wide address buses in K005295 instead of RAS/CAS
GX400_UNFOLD_DRAM_ADDR
SDRAM_FIX
K5291_NO_MUX

[mister]
JTFRAME_ARX=5
JTFRAME_ARY=4
