CORENAME=JTTAITOX

JTFRAME_PXLCLK=8
JTFRAME_RATE=57.44
JTFRAME_WIDTH=384
JTFRAME_HEIGHT=240
JTFRAME_COLORW=5

JTFRAME_VERTICAL


JTFRAME_BUTTONS=3
JTFRAME_JOY_RLDU

JTFRAME_BA1_START=0x080000
PCM_START=0x090000
JTFRAME_BA2_START=0x200000
JTFRAME_BA3_START=0x400000
JTFRAME_PROM_START=0x480000

JTFRAME_HEADER=16

JTFRAME_STEREO

