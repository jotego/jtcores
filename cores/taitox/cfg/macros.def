CORENAME=JTTAITOX

JTFRAME_PXLCLK=8
JTFRAME_RATE=57.44
JTFRAME_WIDTH=384
JTFRAME_HEIGHT=240
JTFRAME_COLORW=5

JTFRAME_VERTICAL


JTFRAME_BUTTONS=3
JTFRAME_JOY_RLDU

RAM_START=0x490000
JTFRAME_BA1_START=0x090000
PCM_START=0x0A0000
JTFRAME_BA2_START=0x200000
JTFRAME_BA3_START=0x400000
CCHIP_START=0x480000
JTFRAME_PROM_START=0x480000

JTFRAME_HEADER=16

JTFRAME_STEREO

debug JTFRAME_IOCTL_RD+=4096
debug JTFRAME_IOCTL_RD+=16384
debug JTFRAME_IOCTL_RD+=1024
JTFRAME_DEBUG_VPOS=6

[mister]
JTFRAME_ARX=4
JTFRAME_ARY=3

[mist|sidi]
# Short of block RAM: the MiST fit needs 76 M9K against the 66 available, so
# the 68000 work RAM goes to SDRAM bank 3 here and stays in BRAM elsewhere.
RAM_IN_SDRAM
JTFRAME_BA3_WEN
# The C-chip ROMs go to SDRAM too, so PROM_START must clear their 12 kB
# region or the loader would divert it to PROMs that no longer exist.
JTFRAME_PROM_START=0x484000
-JTFRAME_CREDITS
JTFRAME_OSD_NOCREDITS
JTFRAME_OSD_NOLOGO
