CORENAME=JTPSPIKE

# 53.365384MHz master. Chosen for its SDRAM clock PHASE, not its frequency:
# outclk_1 (clk48sh) is shifted 5495ps (~106deg), the same family as every PLL
# proven on hardware (6144 ~98deg / 9 cores, 6293 ~89deg / 2, 6671 / rastan).
# pll7159 and pll7000 shift only ~42deg and are used by NO shipped core.
# pll5369 does not shift at all, which also makes Quartus merge outclk_0/1, so
# the SDC create_generated_clock for SDRAM_CLK finds an empty source and is
# silently dropped - SDRAM then runs unconstrained AND unshifted.
JTFRAME_PLL=jtframe_pll6671
JTFRAME_PXLCLK=6
# pspikes/turbofrc rate (61.31 verified on pcb). aerofgtb programs the GGA for a
# 456x250 grid = 62.80 Hz, so the rate is per-game and the check cannot apply.
JTFRAME_RATE=61.31
JTFRAME_SKIP_RATE_TEST
JTFRAME_WIDTH=352
JTFRAME_HEIGHT=240
JTFRAME_COLORW=5
# turbofrc and aerofgtb are ROT270. Rotation is a per-MRA coremod flag, so one
# build serves both orientations
JTFRAME_VERTICAL

JTFRAME_BUTTONS=4
JTFRAME_JOY_RLDU

JTFRAME_HEADER=8


SND_START=0x0C0000
JTFRAME_BA1_START=0x100000
PCMB_START=0x200000
SPRLUT_START=0x280000
JTFRAME_BA2_START=0x300000
SCR1_START=0x400000
JTFRAME_BA3_START=0x600000
OBJ1_START=0xA00000


# Debug options
JTFRAME_STATUS

[mist|sidi]
JTFRAME_SKIP

