CORENAME=JTPSPIKE

JTFRAME_PLL=jtframe_pll7159
# PXLCLK=6 selects a /4 and /8 divider: pxl2_cen 14.318MHz (the GGA crystal)
# and pxl_cen 7.159MHz. The macro name assumes a 48MHz clk, the divider is
# what matters here
JTFRAME_PXLCLK=6
JTFRAME_RATE=61.31
JTFRAME_WIDTH=352
JTFRAME_HEIGHT=240
JTFRAME_COLORW=5
# turbofrc and aerofgtb are ROT270. Rotation is a per-MRA coremod flag, so one
# build serves both orientations
JTFRAME_VERTICAL

JTFRAME_BUTTONS=3
JTFRAME_JOY_RLDU

JTFRAME_HEADER=8


SND_START=0x0C0000
JTFRAME_BA1_START=0x100000
PCMB_START=0x200000
SPRLUT_START=0x280000
JTFRAME_BA2_START=0x300000
SCR1_START=0x400000
JTFRAME_BA3_START=0x600000
OBJ1_START=0xA00000

# Debug options
JTFRAME_STATUS

[mist|sidi]
JTFRAME_SKIP
