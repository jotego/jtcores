CORENAME=JTPSPIKE

JTFRAME_PLL=jtframe_pll7159
# JTFRAME_PLL=jtframe_pll6671
JTFRAME_PXLCLK=6
# pspikes/turbofrc rate (61.31 verified on pcb). aerofgtb programs the GGA for a
# 456x250 grid = 62.80 Hz, so the rate is per-game and the check cannot apply.
JTFRAME_RATE=61.31
JTFRAME_SKIP_RATE_TEST
JTFRAME_WIDTH=352
JTFRAME_HEIGHT=240
JTFRAME_COLORW=5
# turbofrc and aerofgtb are ROT270. Rotation is a per-MRA coremod flag, so one
# build serves both orientations
JTFRAME_VERTICAL

JTFRAME_BUTTONS=4
JTFRAME_JOY_RLDU

JTFRAME_HEADER=8


SND_START=0x0C0000
JTFRAME_BA1_START=0x100000
PCMB_START=0x200000
SPRLUT_START=0x280000
JTFRAME_BA2_START=0x300000
SCR1_START=0x400000
JTFRAME_BA3_START=0x600000
OBJ1_START=0xA00000

# uncomment to bypass the GGA and use jtframe_vtimer (pspikes timing only)
PSPIKE_VTIMER

# Debug options
JTFRAME_STATUS

[mist|sidi]
JTFRAME_SKIP

