CORENAME=JTSYSFL
JTFRAME_RATE=59.66

JTFRAME_STEREO
JTFRAME_BUTTONS=4
JTFRAME_ANALOG
CORE_OSD=OKM,Control Type,A.Stick,A.Triggers,A.Wheel;
JTFRAME_NOMULTIWAY
JTFRAME_HEADER=8
JTFRAME_OSD_NOLOGO
# core-local sprite ROM cache (see hdl/jtframe_romrq_lcache.v)
JTFRAME_CORE_LCACHE
JTFRAME_180SHIFT
JTFRAME_NOHQ2X

# Video configuration
JTFRAME_COLORW=8
JTFRAME_PXLCLK=6
JTFRAME_WIDTH=288
JTFRAME_HEIGHT=224
JTFRAME_ARX=4
JTFRAME_ARY=3

# ROM configuration, byte offsets in download order (see mame2mra.toml)
# bank1 = obj (high SDRAM priority), bank3 = pcm + work RAM
ROZ_START=0x400000
JTFRAME_BA1_START=0x680000
JTFRAME_BA2_START=0xE80000
C75BIOS_START=0x1300000
MCUROM_START=0x1380000
JTFRAME_BA3_START=0x1400000
RMASK_START=0x19A0000
# 64-bit bursts for the sprite ROM, 8 pixels per fetch

JTFRAME_BA1_LEN=64
# bank 3 holds the i960 work RAM
JTFRAME_BA3_WEN

# scene dumps: 6 BRAMs + video MMRs
JTFRAME_IOCTL_RD=352372
# the game asks for the test switch to initialize its backup memory
JTFRAME_OSD_TEST
# 60.48 MHz base clock, 10x the real 6.048 pixel clock: +25% video cycles
# per line. SDRAM and CPU run on the same base; audio keeps PCB divisions
JTFRAME_PLL=jtframe_pllb6048
JTFRAME_BASE_MUL=10

[mister]
# LAB budget is tight: no composite/S-Video encoder, RGB and HDMI unaffected
MISTER_DISABLE_YC
# 32MB ROM set: load through the DDR proxy
JTFRAME_MR_DDRLOAD

[mist|sidi|sidi128]
# not enough resources
JTFRAME_SKIP
