CORENAME=JTSYSFL
JTFRAME_RATE=59.66

JTFRAME_STEREO
JTFRAME_BUTTONS=4
JTFRAME_ANALOG
CORE_OSD=OKM,Control Type,A.Stick,A.Triggers,A.Wheel,Stick+BtnGas;
JTFRAME_NOMULTIWAY
JTFRAME_HEADER=8
JTFRAME_OSD_NOLOGO
# core-local sprite ROM cache (see hdl/jtframe_romrq_lcache.v)
JTFRAME_CORE_LCACHE
JTFRAME_NOHQ2X

# Video configuration
JTFRAME_COLORW=8
JTFRAME_PXLCLK=6
# 48.384 base + 96.768 SDRAM (SDRAM96/HF=1, the fleet-proven regime);
# all core logic stays on clk48, see doc/sdram96-clk48.md
JTFRAME_PLL=jtframe_pll6048
JTFRAME_SDRAM96
JTFRAME_CLK48
JTFRAME_WIDTH=288
JTFRAME_HEIGHT=224
JTFRAME_ARX=4
JTFRAME_ARY=3

# ROM configuration, byte offsets in download order (see mame2mra.toml)
# bank1 = obj, bank2 = pcm + work RAM, bank3 = woven scroll gfx
# rch+rsh and sch+ssh stream raw (masks twice); the pre_addr remap weaves
# them into 8-byte units at bank0 0x400000 and bank3 0x000000, and moves
# the C75 data rom into the bank0 gap at 0x300000
ROZ_START=0x300000
RSH_START=0x500000
JTFRAME_BA1_START=0x800000
JTFRAME_BA2_START=0x1000000
MCUROM_START=0x1400000
C75BIOS_START=0x1480000
JTFRAME_BA3_START=0x1600000
SSH_START=0x1A00000
# 64-bit bursts for the sprite ROM, 8 pixels per fetch

# slow-grade (-75) SDRAM: 20ns tRP/tRCD command spacing above 50 MHz
JTFRAME_SDRAM_TRP20
JTFRAME_BA1_LEN=64
# 64-bit bursts on bank 0 so one burst fills an 8-byte woven roz unit
JTFRAME_BA0_LEN=64
# same for the woven scroll units on bank 3
JTFRAME_BA3_LEN=64
# bank 2 holds the i960 work RAM
JTFRAME_BA2_WEN

# scene dumps: 6 BRAMs + video MMRs
# NVRAM: the 8kB backup memory BRAM, first in the ioctl order.
# MiSTer autoloads <setname>.RAM from saves/ and writes it on OSD save settings
JTFRAME_IOCTL_RD=8192
# the game asks for the test switch to initialize its backup memory
JTFRAME_OSD_TEST
# stock 48 MHz base clock: every 60 MHz variant hung on real hardware

[mister]
# 32MB ROM set: load through the DDR proxy
JTFRAME_MR_DDRLOAD
# LAB budget is tight: no composite/S-Video encoder, RGB and HDMI unaffected
MISTER_DISABLE_YC

[mist|sidi|sidi128]
# not enough resources
JTFRAME_SKIP
