CORENAME=JTSYSFL
JTFRAME_RATE=59.19

JTFRAME_STEREO
JTFRAME_BUTTONS=4
JTFRAME_ANALOG
CORE_OSD=OKM,Control Type,A.Stick,A.Triggers,A.Wheel,Stick+BtnGas;
JTFRAME_NOMULTIWAY
JTFRAME_HEADER=16
JTFRAME_OSD_NOLOGO
JTFRAME_NOHQ2X

# Video configuration
JTFRAME_COLORW=8
JTFRAME_PXLCLK=6
JTFRAME_WIDTH=288
JTFRAME_HEIGHT=224
JTFRAME_ARX=4
JTFRAME_ARY=3

# dual-chip SDRAM (128 MB space), cache lanes. Single-rate 48 MHz: SDRAM96
# doubles the game clock domain in jtframe, out of scope for this migration
JTFRAME_SDRAM_XL
# ROM configuration, byte offsets in the 128 MB download space (16 MB banks,
# chip 1 starts at 0x4000000). rch+rsh and sch+ssh stream raw after their
# woven windows; the pre_addr remap weaves them into 8-byte units
C75BIOS_START=0x300000
MCUROM_START=0x1000000
PCM_START=0x2000000
OBJ_START=0x3000000
ROZ_START=0x4000000
RSH_START=0x4200000
SCH_START=0x5000000
SSH_START=0x5400000

# scene dumps: 6 BRAMs + video MMRs
# NVRAM: the 8kB backup memory BRAM, first in the ioctl order.
# MiSTer autoloads <setname>.RAM from saves/ and writes it on OSD save settings
JTFRAME_IOCTL_RD=8192
# the game asks for the test switch to initialize its backup memory
JTFRAME_OSD_TEST
# stock 48 MHz base clock: every 60 MHz variant hung on real hardware

[mister]
# 32MB ROM set: load through the DDR proxy
JTFRAME_MR_DDRLOAD
# LAB budget is tight: no composite/S-Video encoder, RGB and HDMI unaffected
MISTER_DISABLE_YC

[mist|sidi|sidi128]
# not enough resources
JTFRAME_SKIP
