CORENAME=JTSYSFL
JTFRAME_RATE=59.19

JTFRAME_STEREO
JTFRAME_BUTTONS=4
JTFRAME_ANALOG
CORE_OSD=OKM,Control Type,A.Stick,A.Triggers,A.Wheel,Stick+BtnGas;
JTFRAME_NOMULTIWAY
JTFRAME_HEADER=8
JTFRAME_OSD_NOLOGO
# core-local sprite ROM cache (see hdl/jtframe_romrq_lcache.v)
JTFRAME_CORE_LCACHE
JTFRAME_NOHQ2X

# Video configuration
JTFRAME_COLORW=8
JTFRAME_PXLCLK=6
JTFRAME_PLL=jtframe_plle6000
JTFRAME_BASE_MUL=9
JTFRAME_WIDTH=288
JTFRAME_HEIGHT=224
JTFRAME_ARX=4
JTFRAME_ARY=3

# ROM configuration, byte offsets in download order (see mame2mra.toml)
# bank1 = obj (high SDRAM priority), bank3 = pcm + work RAM
ROZ_START=0x400000
JTFRAME_BA1_START=0x1000000
JTFRAME_BA2_START=0x2000000
C75BIOS_START=0x2480000
MCUROM_START=0x2500000
JTFRAME_BA3_START=0x3000000
RMASK_START=0x35A0000
# 64-bit bursts for the sprite ROM, 8 pixels per fetch

JTFRAME_BA1_LEN=64
# 64MB module addressing: every bank spans 16MB
JTFRAME_SDRAM_LARGE
# bank 3 holds the i960 work RAM
JTFRAME_BA3_WEN

# scene dumps: 6 BRAMs + video MMRs
JTFRAME_IOCTL_RD=352372
JTFRAME_OSD_TEST
JTFRAME_MR_DDRLOAD
MISTER_DISABLE_YC


[mist|sidi|sidi128]
JTFRAME_SKIP
