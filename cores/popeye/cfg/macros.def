CORENAME=JTPOPEYE

JTFRAME_BUTTONS=2
JTFRAME_HEADER=4
JTFRAME_RATE=61.40

JTFRAME_WIDTH=512
JTFRAME_HEIGHT=224
JTFRAME_COLORW=3
JTFRAME_INTERLACED
# 48 MHz / 10.08 MHz = 100/21 clocks per native pixel.
JTFRAME_HSIZE_DIV=5
JTFRAME_HSIZE_NUM=100
JTFRAME_HSIZE_DEN=21

CHAR_START=0x8000
OBJ_START =0x9000
JTFRAME_PROM_START=0x11000

JTFRAME_IOCTL_RD=16384

JTFRAME_JOY_DULR

[mist|sidi|sidi128|neptuno]
# These targets use jtframe_scan2x; its buffer spans the 640-pixel line.
JTFRAME_SCAN2X_HLEN=640
