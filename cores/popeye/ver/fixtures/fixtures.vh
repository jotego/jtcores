// Deterministic test inputs generated by init.go; no game ROMs are required.
`ifndef POPEYE_FIXTURES
`define POPEYE_FIXTURES
`define PROM "timing.bin"
`define CHARROM "chars.bin"
`define ROM1E "obj0.bin"
`define ROM1F "obj1.bin"
`define ROM1J "obj2.bin"
`define ROM1K "obj3.bin"
`define P7J "timing.bin"
`define P3A "txtpal.bin"
`define P4A "bgpal.bin"
`define P5B "objpall.bin"
`define P5A "objpalh.bin"
`ifndef POPEYE_ANA_CASE
`define POPEYE_ANA_CASE 0
`endif
`define DEFL ((`POPEYE_ANA_CASE<4)?`POPEYE_ANA_CASE:((`POPEYE_ANA_CASE==9)?3:0))
`define NARROW ((`POPEYE_ANA_CASE==4)||(`POPEYE_ANA_CASE==7)||(`POPEYE_ANA_CASE==9))
`define HPOS ((`POPEYE_ANA_CASE==5 || `POPEYE_ANA_CASE==7)?31:((`POPEYE_ANA_CASE==8)?-32:((`POPEYE_ANA_CASE==9)?-5:0)))
`define VPOS ((`POPEYE_ANA_CASE==5)?15:((`POPEYE_ANA_CASE==6)?6:((`POPEYE_ANA_CASE==8)?-16:((`POPEYE_ANA_CASE==9)?7:0))))
`ifndef POPEYE_BG_CASE
`define POPEYE_BG_CASE 0
`endif
`define BOARD ((`POPEYE_BG_CASE<3)?0:((`POPEYE_BG_CASE<5)?1:((`POPEYE_BG_CASE==5)?2:3)))
`define RV ((`POPEYE_BG_CASE==1)||(`POPEYE_BG_CASE==4)||(`POPEYE_BG_CASE==7))
`define IMG (`POPEYE_BG_CASE==2)
`endif
