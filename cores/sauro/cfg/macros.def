[*]
CORENAME=JTSAURO

JTFRAME_CLK24
JTFRAME_BUTTONS=2

# Video: 256x256 bitmap, MAME visarea 8-247 x 16-239
# 6MHz pxl clock, 384x280 grid -> 15.625kHz / 55.80Hz (PCB: 55.72Hz)
JTFRAME_PXLCLK=6
JTFRAME_WIDTH=256
JTFRAME_HEIGHT=224
JTFRAME_RATE=55.80

# SDRAM banks. Room left for the sauro sets (audio CPU + FG tiles + 128kB sprites)
SND_START         =0x10000
JTFRAME_BA1_START =0x20000
FG_START          =0x30000
JTFRAME_BA2_START =0x40000
JTFRAME_PROM_START=0x60000
