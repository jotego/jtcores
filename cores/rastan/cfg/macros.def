CORENAME=JTRASTAN

JTFRAME_STEREO
# 6.667MHz pixel clock
JTFRAME_PLL=jtframe_pll6671
JTFRAME_WIDTH=320
JTFRAME_HEIGHT=240

JTFRAME_COLORW=5
JTFRAME_HEADER=8
JTFRAME_LIGHTGUN

JTFRAME_MR_DDRLOAD
JTFRAME_BA1_START=0x80000
PCM_START=0x90000
JTFRAME_BA2_START=0x110000
JTFRAME_BA3_START=0x190000
JTFRAME_PROM_START=0x280000

JTFRAME_CREDITS_HSTART=32

# 8 KiB object RAM, 64 KiB tile RAM, 4 KiB palette RAM, 32 bytes of MMR,
# and the object-palette register
JTFRAME_IOCTL_RD=77857

[mist]
JTFRAME_NOSTA

[sidi]
-JTFRAME_CREDITS

[mist|sidi]
RASTAN_SCRRAM_SDRAM
