CORENAME=JTRASTAN

JTFRAME_STEREO
# 6.667MHz pixel clock
JTFRAME_CLK24
JTFRAME_PLL=jtframe_pll6671
JTFRAME_WIDTH=320
JTFRAME_HEIGHT=240

JTFRAME_COLORW=5
JTFRAME_HEADER=8
JTFRAME_LIGHTGUN

# BA1/PCM/PROM starts sized for the largest program+GFX ROMs (Rainbow Islands:
# 0x80000 maincpu, 0xa0000 sprites). Rastan/Op Wolf are smaller and just leave
# an FF gap. PCM_OFFSET=(PCM_START-BA1_START)>>1 is unchanged at 0x8000.
JTFRAME_BA1_START=0x80000
PCM_START=0x90000
JTFRAME_BA2_START=0x100000
JTFRAME_BA3_START=0x180000
JTFRAME_PROM_START=0x280000

JTFRAME_CREDITS_HSTART=32

# debugging
JTFRAME_IOCTL_RD=1024

[mist]
JTFRAME_NOSTA
